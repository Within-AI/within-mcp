{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-design.invalid/formats/lists/expression.schema.json",
  "version": "agent-design.expression/1",
  "title": "expression.schema.json",
  "description": "Expression language: a block {reads, test, sets} of JSON nodes. Arithmetic appears only as a calc node. See expression-language.md.",
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "literal",
            "read",
            "compare",
            "and",
            "or",
            "not",
            "in",
            "is_null",
            "is_not_applicable",
            "calc"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "literal"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "read"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "token"
            ],
            "properties": {
              "token": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "compare"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "op",
              "left",
              "right"
            ],
            "properties": {
              "op": {
                "enum": [
                  "==",
                  "!=",
                  "<",
                  "<=",
                  ">",
                  ">="
                ]
              },
              "left": {
                "$ref": "#/$defs/node"
              },
              "right": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "and"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "args"
            ],
            "properties": {
              "args": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "$ref": "#/$defs/node"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "or"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "args"
            ],
            "properties": {
              "args": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "$ref": "#/$defs/node"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "not"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "arg"
            ],
            "properties": {
              "arg": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "in"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "value_of",
              "list"
            ],
            "properties": {
              "value_of": {
                "$ref": "#/$defs/node"
              },
              "list": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "is_null"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "token"
            ],
            "properties": {
              "token": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "is_not_applicable"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "token"
            ],
            "properties": {
              "token": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "calc"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "step",
              "fn",
              "args"
            ],
            "properties": {
              "step": {
                "type": "string",
                "minLength": 1
              },
              "fn": {
                "enum": [
                  "add",
                  "subtract",
                  "multiply",
                  "divide",
                  "sum",
                  "abs",
                  "round"
                ]
              },
              "args": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/node"
                }
              }
            }
          }
        }
      ]
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reads",
        "test",
        "sets"
      ],
      "properties": {
        "reads": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "test": {
          "$ref": "#/$defs/node"
        },
        "sets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/node"
          }
        }
      }
    }
  },
  "$ref": "#/$defs/block"
}
